{
  "name": "open-datacenter-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Interactive digital twin front end for the Open Data Center Facility model",
  "scripts": {
    "data": "cd .. && python3 -m dcf.cli web-data",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "npm run data && vitest run",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "eslint": "^10.15.0",
    "three": "^0.187.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
